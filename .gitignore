# 依赖目录
node_modules/

# IDE配置
# Note: use ".vscode/*" (exclude contents) rather than ".vscode/" (exclude dir)
# so the per-file negations below can re-include shared configs.
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json

# 测试框架
.vscode-test/

# 构建产物
**/*.map
out/
*.vsix

# 系统文件
.DS_Store

# 项目配置
.gitignore
.vscodeignore

# 其他常见忽略项
**/*.log
**/tmp/
**/dist/

# Python (generated by the sage doc daemon at runtime)
**/__pycache__/
**/*.pyc

# 临时测试文件
test_*.js

# 排除不应被忽略的文件
!.gitignore
!.vscodeignore
